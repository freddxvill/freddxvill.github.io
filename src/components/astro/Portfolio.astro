---
import Layout from "@/layouts/Layout.astro";
import Check from "@/components/astro/ui/Check.astro";
import VeryLongArrowRightDown from "@/components/astro/ui/VeryLongArrowRightDown.astro";
import { portfolio, projects, type Language } from "@/data/portfolio";
import "@/styles/portfolio.css";

interface Props { lang: Language }
const { lang } = Astro.props;
const t = portfolio[lang];
const isEs = lang === "es";
const projectTotal = String(projects.length).padStart(2, "0");
const projectImageAlts = {
  es: [
    "Logo de Thinka sobre materiales de aprendizaje de color naranja",
    "Logo de UNATIVE entre dos perfiles y ondas de conversación",
    "Manos con puntos de seguimiento del movimiento",
    "Logo de SincroMED entre tarjetas de pacientes y citas",
    "Conversaciones que avanzan por un flujo de ventas",
    "Gráfico de divisas y análisis de mercado",
    "Mapa del Reino Unido con barras de gasto por región",
    "Fotogramas conectados a un flujo de datos y una API",
  ],
  en: [
    "Thinka logo over orange learning materials",
    "UNATIVE logo between two profiles and conversation waves",
    "Hands with movement tracking points",
    "SincroMED logo between patient and appointment cards",
    "Conversations moving through a sales pipeline",
    "Currency chart and market analysis",
    "Map of the United Kingdom with regional spending bars",
    "Film frames connected to a data pipeline and API",
  ],
} as const;
const brandedProjects = new Set<string>(["thinka", "syncromedia", "unative"]);
const toolGroups = [
  { items: ["Python", "pandas", "SQL", "Jupyter", "Plotly", "Sklearn", "Spark"], project: "retail" },
  { items: ["PyTorch", "Transformers", "MediaPipe", "LangGraph", "LLM APIs", "RAG", "MCP"], project: "lsb" },
  { items: ["FastAPI", "Celery", "Streamlit", "Docker", "PostgreSQL", "GitHub Actions", "VPS deploy"], project: "thinka" },
] as const;
const site = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, "");
const title = "Freddy Villca Villegas | Data Science, Machine Learning & AI Engineering";
const description = isEs
  ? "Portafolio de Freddy Villca Villegas: ciencia de datos, aprendizaje automático e ingeniería de IA. Proyectos en visión por computadora, agentes, analítica y despliegue de modelos."
  : "Portfolio of Freddy Villca Villegas: data science, machine learning and AI engineering. Projects in computer vision, agents, analytics and model deployment.";
const schema = {
  "@context": "https://schema.org", "@type": "ProfilePage", name: title, description,
  ...(site ? { url: `${site}/${lang}/` } : {}),
  mainEntity: {
    "@type": "Person", name: "Freddy Villca Villegas",
    jobTitle: "Electromechanical engineer · Data Science & AI",
    address: { "@type": "PostalAddress", addressLocality: "Cochabamba", addressCountry: "BO" },
    email: "mailto:fvillcavillegas@gmail.com",
    sameAs: ["https://github.com/freddxvill", "https://www.linkedin.com/in/freddy-villca-villegas/"],
  },
};
---

<Layout lang={lang} title={title} description={description}>
  <a class="skip-link" href="#main">{isEs ? "Saltar al contenido" : "Skip to content"}</a>
  <header class="site-header" id="top"><div class="shell header-inner">
    <a class="wordmark" href={`/${lang}/`} aria-label="Freddy Villca Villegas — inicio">FV<span class="wordmark-dot">.</span><span class="wordmark-name"> Freddy Villca Villegas</span></a>
    <nav class="main-nav" aria-label={isEs ? "Navegación principal" : "Main navigation"}>
      <a href="#proyectos">{t.nav[0]}</a><a href="#contacto">{t.nav[1]}</a>
    </nav>
    <a class="language-link" href={isEs ? "/en/" : "/es/"} lang={isEs ? "en" : "es"} aria-label={isEs ? "Switch to English" : "Cambiar a español"}><span class="language-label">{isEs ? "EN" : "ES"}</span><span aria-hidden="true"> ↗</span></a>
  </div></header>

  <main id="main">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-eyebrow">{isEs ? "Ciencia de datos · Machine learning · IA" : "Data science · Machine learning · AI"}</p>
        <h1 id="hero-title"><span>{t.hero[0]}</span><span>{t.hero[1]} <em>{t.hero[2]}</em></span></h1>
        <p class="hero-intro">{t.intro}</p>
        <div class="hero-links"><a class="button button-primary" href="#proyectos"><span class="button-arrow" aria-hidden="true">↗</span><span class="button-label">{t.work}</span></a><a class="text-link" href="mailto:fvillcavillegas@gmail.com">{t.contact}<span aria-hidden="true"> ↗</span></a></div>
      </div>
      <aside class="hero-aside" aria-label={t.sideLabel}>
        <div class="hero-portrait-stage">
          <div class="portrait-wrap"><img src="/freddy-avatar.jpg" alt={isEs ? "Retrato ilustrado de Freddy Villca Villegas" : "Illustrated portrait of Freddy Villca Villegas"} width="460" height="460" fetchpriority="high" /></div>
        </div>
        <div class="hero-aside-copy"><div class="hero-aside-heading"><span class="small-label">{t.sideLabel}</span><span class="location">↗ {t.location}</span></div><ul class="hero-credentials">{t.side.map((detail) => <li>{detail}</li>)}</ul></div>
      </aside>
    </section>

    <section class="work-section" id="proyectos" aria-labelledby="work-title"><div class="shell">
      <div class="section-heading"><div><p class="section-kicker"><span class="section-index">01</span>{t.workLabel}</p><h2 id="work-title">{t.workTitle}</h2></div><p>{t.workIntro}</p></div>
      <div class="project-list">
        {projects.map((project, i) => <article class={`project project-${project.visual}`} id={project.slug} style={`--project-index:${i}`}>
          <div class="project-head"><span class="project-number">{String(i + 1).padStart(2, "0")} / {projectTotal}</span><h3>{t.projects[i].title}</h3><span class="project-kind">{t.projects[i].kind}</span><span class="project-head-mark" aria-hidden="true">↗</span></div>
          <div class="project-body"><div class="project-visual"><img class="project-image" src={`/projects/${project.slug}.webp`} alt={projectImageAlts[lang][i]} width="1280" height="853" loading="lazy" decoding="async" />{brandedProjects.has(project.slug) && <img class="project-brand-logo" src={`/projects/${project.slug}-logo.webp`} alt="" loading="lazy" decoding="async" />}</div>
          <div class="project-content"><div class="project-story"><div><span class="small-label">{t.problemLabel}</span><p>{t.projects[i].problem}</p></div><div><span class="small-label">{t.solutionLabel}</span><p>{t.projects[i].solution}</p></div></div><ul class="tag-list" aria-label={isEs ? "Tecnologías" : "Technologies"}>{project.tags.map((tag) => <li>{tag}</li>)}</ul><div class="project-actions">{"private" in project && project.private ? <span class="private-repo">{t.privateRepo}</span> : <a href={project.url} target="_blank" rel="noopener noreferrer">{"link" in project && project.link === "product" ? t.product : t.repo}<span aria-hidden="true"> ↗</span></a>}{"demo" in project && project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer">{t.demo}<span aria-hidden="true"> ↗</span></a>}</div></div></div>
        </article>)}
      </div>
      <a class="all-projects" href="https://github.com/freddxvill?tab=repositories" target="_blank" rel="noopener noreferrer">{t.all}<span aria-hidden="true"> ↗</span></a>
    </div></section>

    <section class="about-section" id="perfil" aria-labelledby="about-title"><div class="shell about-grid"><div><p class="section-kicker"><span class="section-index">02</span>{t.aboutLabel}</p><h2 id="about-title">{t.aboutTitle}</h2></div><div class="about-copy"><p>{t.about}</p><div class="about-principle"><span class="small-label">{t.approachLabel}</span><p>{t.approach}</p></div><a class="inline-arrow" href="https://www.linkedin.com/in/freddy-villca-villegas/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="toolkit-section" id="tecnologias" aria-labelledby="toolkit-title" aria-describedby="toolkit-description"><div class="shell toolkit-shell">
      <div class="toolkit-intro" id="toolkit-animation"><p class="toolkit-intro-label">/ 03 / DATA · ML · AI</p><h2 id="toolkit-title">{t.toolsTitle}</h2><p id="toolkit-description">{t.toolsIntro}</p></div>
      <div class="toolkit-details"><div class="toolkit-details-head"><span>/ {t.toolsLabel} /</span><span>FREDDY VILLCA VILLEGAS</span></div>
        <div class="toolkit-grid">{toolGroups.map((group, i) => <article class={`toolkit-card toolkit-card-${i + 1}`}>
          <div class="toolkit-card-head"><span>{String(i + 1).padStart(2, "0")} / 03</span><h3>{t.groups[i]}</h3></div>
          <ul>{group.items.map((item) => <li><span class="toolkit-check" aria-hidden="true"><Check /></span>{item}</li>)}</ul>
          <a class="toolkit-card-link" href={`#${group.project}`}>{t.toolsProject}<span aria-hidden="true">↗</span></a>
        </article>)}</div>
      </div>
    </div></section>

    <section class="motion-section" aria-labelledby="motion-title"><div class="shell"><div class="motion-heading"><p class="section-kicker"><span class="section-index">04</span>{t.motionLabel}</p><h2 id="motion-title">{t.motionTitle}</h2></div><div class="car-art"><object id="car-motion" data="/car-animation.svg" type="image/svg+xml" role="img" aria-label={t.motionAlt} tabindex="-1"><img src="/car-animation.svg" alt={t.motionAlt} loading="lazy" /></object></div></div></section>

    <section class="contact-section" id="contacto" aria-labelledby="contact-title"><div class="shell">
      <div class="contact-topline"><p>/ {t.contactLabel} /</p><span>FREDDY VILLCA VILLEGAS · DATA / ML / AI</span></div>
      <h2 class="contact-display" id="contact-title"><span>{t.contactTitleFirst}</span><span class="contact-display-second"><span>{t.contactTitleSecond}</span><span class="contact-arrow" aria-hidden="true"><VeryLongArrowRightDown /></span></span></h2>
      <div class="contact-bottom"><p>{t.contactIntro}</p><div class="contact-actions"><a class="button button-light" href="mailto:fvillcavillegas@gmail.com"><span class="button-arrow" aria-hidden="true">↗</span><span class="button-label">{t.email}</span></a><a href="https://www.linkedin.com/in/freddy-villca-villegas/" target="_blank" rel="noopener noreferrer">{t.linkedin}<span aria-hidden="true">↗</span></a><a href="https://github.com/freddxvill" target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a></div></div>
    </div></section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>

<script>
  import Lenis from "lenis";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  const scrollMotionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const lenis = new Lenis({ smoothWheel: !scrollMotionPreference.matches });
  lenis.on("scroll", ScrollTrigger.update);
  gsap.ticker.add((time) => lenis.raf(time * 1000));
  gsap.ticker.lagSmoothing(0);

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    if (link.classList.contains("skip-link")) return;
    link.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const hash = link.getAttribute("href");
      const target = hash && document.getElementById(hash.slice(1));
      if (!target) return;
      event.preventDefault();
      history.pushState(null, "", hash);
      lenis.scrollTo(target, { offset: -16, duration: scrollMotionPreference.matches ? 0 : 1.5, immediate: scrollMotionPreference.matches });
    });
  });

  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.from(".hero h1 > *, .hero-intro, .hero-links", {
      y: 28, autoAlpha: 0, duration: 0.8, ease: "power3.out", stagger: 0.09,
    });
    gsap.from(".hero-aside", { y: 36, autoAlpha: 0, duration: 1, delay: 0.3, ease: "power3.out" });

    document.querySelectorAll<HTMLElement>(".section-heading, .motion-heading").forEach((heading) => {
      gsap.from(heading.children, {
        y: 30, autoAlpha: 0, duration: 0.75, stagger: 0.12, ease: "power2.out",
        scrollTrigger: { trigger: heading, start: "top 85%", once: true },
      });
    });
    document.querySelectorAll<HTMLElement>(".project").forEach((project) => {
      gsap.from(project.querySelectorAll(".project-body > *"), {
        y: 24, autoAlpha: 0, duration: 0.7, stagger: 0.07, ease: "power2.out",
        scrollTrigger: { trigger: project, start: "top 82%", once: true },
      });
    });
    gsap.from(".about-grid > div", {
      y: 36, autoAlpha: 0, duration: 0.85, stagger: 0.12, ease: "power2.out",
      scrollTrigger: { trigger: ".about-section", start: "top 78%", once: true },
    });
    gsap.from(".toolkit-card", {
      y: 28, autoAlpha: 0, duration: 0.8, stagger: 0.12, ease: "power2.out",
      scrollTrigger: { trigger: ".toolkit-grid", start: "top 85%", once: true },
    });
    gsap.from(".car-art", {
      y: 36, autoAlpha: 0, duration: 0.85, ease: "power2.out",
      scrollTrigger: { trigger: ".car-art", start: "top 82%", once: true },
    });
    gsap.from(".contact-topline, .contact-display, .contact-bottom", {
      y: 34, autoAlpha: 0, duration: 0.85, stagger: 0.12, ease: "power2.out",
      scrollTrigger: { trigger: ".contact-section", start: "top 80%", once: true },
    });

    const arrowPaths = gsap.utils.toArray<SVGPathElement>(".contact-arrow path");
    arrowPaths.forEach((path) => {
      const length = path.getTotalLength() + 10;
      gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
    });
    gsap.timeline({
      scrollTrigger: { trigger: ".contact-section", start: "top 30%", end: "bottom bottom", scrub: 1, invalidateOnRefresh: true },
      defaults: { ease: "none" },
    }).to(arrowPaths[1], { strokeDashoffset: 0, duration: 2 })
      .to(arrowPaths[0], { strokeDashoffset: 0, duration: 0.5 });
  });

  mm.add({
    isShort: "(max-height: 799px)",
    isNarrow: "(max-width: 450px)",
    reduceMotion: "(prefers-reduced-motion: reduce)",
  }, (context) => {
    if (context.conditions?.reduceMotion || (context.conditions?.isShort && context.conditions?.isNarrow)) return;
    gsap.fromTo("#toolkit-animation", { filter: "blur(14px)" }, {
      filter: "blur(0px)", ease: "none",
      scrollTrigger: { trigger: "#toolkit-animation", start: "top 90%", end: "top 35%", scrub: 1, invalidateOnRefresh: true },
    });
  });

  mm.add("(min-width: 768px) and (prefers-reduced-motion: no-preference)", () => {
    gsap.to(".toolkit-section", {
      scale: 0.9, transformOrigin: "center bottom", ease: "none",
      scrollTrigger: { trigger: ".toolkit-section", start: "bottom bottom", end: "bottom top", scrub: 1, invalidateOnRefresh: true },
    });
  });

  mm.add("(min-width: 960px) and (min-height: 680px) and (prefers-reduced-motion: no-preference)", () => {
    const cards = gsap.utils.toArray<HTMLElement>(".project-list .project");
    const list = document.querySelector<HTMLElement>(".project-list");
    const rowHeight = () => cards[0]?.querySelector<HTMLElement>(".project-head")?.offsetHeight ?? 64;
    let activeIndex = -1;
    const updateActive = () => {
      let nextIndex = 0;
      cards.forEach((card, index) => {
        if (card.getBoundingClientRect().top <= index * rowHeight() + 8) nextIndex = index;
      });
      if (nextIndex === activeIndex) return;
      activeIndex = nextIndex;
      cards.forEach((card, index) => card.classList.toggle("is-active", index === activeIndex));
    };

    if (list) ScrollTrigger.create({
      trigger: list,
      start: "top bottom",
      end: "bottom top",
      onUpdate: updateActive,
      onRefresh: updateActive,
    });
    const initialUpdate = requestAnimationFrame(updateActive);

    cards.forEach((card, index) => {
      if (index === 0) return;
      const previousBody = cards[index - 1].querySelector<HTMLElement>(".project-body");
      if (!previousBody) return;
      gsap.to(previousBody, {
        autoAlpha: 0,
        ease: "none",
        scrollTrigger: {
          trigger: card,
          start: () => `top top+=${index * rowHeight() + 150}`,
          end: () => `top top+=${index * rowHeight()}`,
          scrub: 0.4,
          invalidateOnRefresh: true,
        },
      });
    });

    return () => {
      cancelAnimationFrame(initialUpdate);
      cards.forEach((card) => card.classList.remove("is-active"));
      gsap.set(cards.map((card) => card.querySelector(".project-body")).filter(Boolean), { clearProps: "opacity,visibility" });
    };
  });

  const car = document.querySelector<HTMLObjectElement>("#car-motion");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let carVisible = false;
  const setCarPlayback = () => {
    const svg = car?.contentDocument?.documentElement as unknown as SVGSVGElement | null;
    if (svg?.namespaceURI !== "http://www.w3.org/2000/svg" || typeof svg.pauseAnimations !== "function") return;
    if (carVisible && !reducedMotion.matches) svg.unpauseAnimations();
    else svg.pauseAnimations();
  };
  car?.addEventListener("load", setCarPlayback);
  reducedMotion.addEventListener("change", setCarPlayback);
  if (car) {
    new IntersectionObserver(([entry]) => {
      carVisible = entry.isIntersecting;
      setCarPlayback();
    }, { rootMargin: "80px" }).observe(car);
  }
</script>
