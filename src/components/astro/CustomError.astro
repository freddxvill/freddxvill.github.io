---
import Layout from "@/layouts/Layout.astro";
import { SEO } from "astro-seo";
---

<Layout>
	<SEO
		slot="head"
		title="404 Not Found"
		description="The page you are looking for does not exist."
	/>
	<main class="flex min-h-screen items-center justify-center px-4">
		<section class="flex flex-col items-center gap-5">
			<p
				class="whitespace-nowrap text-[0.65rem] font-normal uppercase leading-7 text-muted-foreground md:text-xs">
				/ 404 /
			</p>
			<h1 data-error-copy="heading" class="text-lg sm:text-2xl md:text-4xl">
				Page not found.
			</h1>
			<p
				data-error-copy="description"
				class="text-center text-sm leading-[1.4] text-muted-foreground md:leading-[1.8] lg:text-base lg:leading-[1.8]">
				You have entered enemy territory. Return to safety immediately!
			</p>
			<a
				data-error-home
				href="/en/"
				class="text-sm underline underline-offset-4">
				Return home
			</a>
		</section>
	</main>
</Layout>

<script>
	import { resolvePreferredLanguage } from "../../../i18n.config.mjs";

	const copy = {
		en: {
			title: "404 Not Found",
			heading: "Page not found.",
			description:
				"You have entered enemy territory. Return to safety immediately!",
			home: "Return home",
		},
		es: {
			title: "404 Página no encontrada",
			heading: "Página no encontrada.",
			description:
				"Has entrado en territorio desconocido. ¡Vuelve a un lugar seguro!",
			home: "Volver al inicio",
		},
	} as const;

	const cookieLanguage = document.cookie
		.split(";")
		.map((entry) => entry.trim())
		.find((entry) => entry.startsWith("lang="))
		?.slice("lang=".length);
	const language = resolvePreferredLanguage(
		cookieLanguage,
		navigator.languages.join(","),
	);
	const selectedCopy = copy[language as keyof typeof copy] ?? copy.en;

	document.documentElement.lang = language;
	document.title = selectedCopy.title;
	document.querySelector('[data-error-copy="heading"]')!.textContent =
		selectedCopy.heading;
	document.querySelector('[data-error-copy="description"]')!.textContent =
		selectedCopy.description;
	const homeLink = document.querySelector<HTMLAnchorElement>("[data-error-home]")!;
	homeLink.textContent = selectedCopy.home;
	homeLink.href = `/${language}/`;
</script>
