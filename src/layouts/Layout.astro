---
import "@/styles/global.css";
import "@/styles/preflight.css";

interface Props { lang?: "es" | "en"; title?: string; description?: string }
const { lang = "es", title = "Freddy Villca Villegas", description = "Portafolio de Freddy Villca Villegas." } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, "");
const canonical = site ? `${site}${Astro.url.pathname}` : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f1eb" />
    <meta name="author" content="Freddy Villca Villegas" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}
    {site && <><link rel="alternate" hreflang="es" href={`${site}/es/`} /><link rel="alternate" hreflang="en" href={`${site}/en/`} /><link rel="alternate" hreflang="x-default" href={`${site}/es/`} /></>}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "es" ? "es_BO" : "en_US"} />
    {canonical && <meta property="og:url" content={canonical} />}
    {site && <meta property="og:image" content={`${site}/freddy-avatar.jpg`} />}
    <meta name="twitter:card" content={site ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/font/PPMori-Regular-compressed.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
